CONFIG_IDF_TARGET="esp32s3"
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_HID_SERVICE=y
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SVC_HID_MAX_RPTS=8
# Subscriptions are stored per bonded host: 3 slots x up to 8 CCCDs, plus spare.
# The default (8 in total) let the first host starve the others.
CONFIG_BT_NIMBLE_MAX_CCCDS=32

# CoreS3: 8 MB quad PSRAM, used for Wi-Fi/LwIP buffers next to BLE and USB.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
# Development link: OTA over Wi-Fi and UDP logs (main/dev_link.cpp).
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
# Internal RAM is shared with USB host DMA; Wi-Fi only carries OTA and logs.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_RX_BA_WIN=6
# The console UART blocks the logging task; keep log lines short in time.
CONFIG_ESP_CONSOLE_UART_BAUDRATE=2000000
